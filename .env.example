# ─── Site ───────────────────────────────────────────
# Canonical production URL — used for metadata, OG image, sitemap, robots, JSON-LD.
# Leave unset in local dev to fall back to the default in src/data/site.ts.
NEXT_PUBLIC_SITE_URL=https://something.vercel.app
# HubSpot tracking portal ID (analytics snippet). Leave unset to use the built-in default.
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=247221692

# ─── Contact Form ───────────────────────────────────
# Resend API key (server-side only). Get one at https://resend.com/api-keys
RESEND_API_KEY=
# Verified sender address in Resend (or onboarding@resend.dev for testing)
CONTACT_FROM_EMAIL=
# Where inquiries are delivered
CONTACT_TO_EMAIL=

# ─── Social Links ───────────────────────────────────
# Any entry left empty is hidden from the site (footer, hero, sameAs JSON-LD).
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GITHUB_URL=
# Email link — can be a mailto: or a contact URL
NEXT_PUBLIC_EMAIL_URL=mailto:hello@dhruva.dev
# Optional: included in Organization "sameAs" structured data
NEXT_PUBLIC_TWITTER_URL=

# ─── Production (Deploy / Vercel) ────────────────────
# Generates /sitemap.xml, /robots.txt and /manifest.webmanifest from the config
# above automatically. No extra files needed.